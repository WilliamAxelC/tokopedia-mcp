# Server Configuration
PORT=3001
HOST=0.0.0.0
NODE_ENV=development

# MCP Transport: 'stdio' or 'sse' (default: sse when run as service, stdio when --stdio flag is passed)
MCP_TRANSPORT=sse

# Base path prefix if running behind reverse proxy (e.g. /tokopedia)
BASE_PATH=/tokopedia

# Tokopedia Session Cookie (optional - for personalized results or bypassing strict bot challenges)
# Example: _SID_Tokopedia=...; _abck=...; bm_sz=...;
TOKOPEDIA_COOKIE=

# Proxy support (optional - HTTP/HTTPS/SOCKS5 proxy for cloud servers / datacenter IPs)
# Example: http://user:pass@proxy-host:8080 or socks5://127.0.0.1:1080
HTTP_PROXY=
HTTPS_PROXY=

# In-Memory Cache TTL in seconds (default: 300 = 5 minutes)
CACHE_DEFAULT_TTL=300

# Cache TTL for product details in seconds (default: 1800 = 30 minutes)
CACHE_PRODUCT_TTL=1800

# Cache TTL for shop info in seconds (default: 3600 = 1 hour)
CACHE_SHOP_TTL=3600

# Request delay between outbound calls in milliseconds (prevents rapid-fire rate limiting)
REQUEST_DELAY_MS=400

# Fallback to realistic mock data if Tokopedia anti-bot blocks connection (true/false)
MOCK_ON_BLOCKED=true

# Custom User-Agent (optional)
USER_AGENT=

# Log Level: debug | info | warn | error
LOG_LEVEL=info
